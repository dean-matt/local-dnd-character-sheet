{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "module": "preserve"
  },
  "include": [
    "**/*.ts",
    "../e2e/**/*.ts",
    "../playwright.config.ts",
    "../vitest.config.ts",
    "../packages/{shared,content,api}/src/**/*.test.ts"
  ]
}
