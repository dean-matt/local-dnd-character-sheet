{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "module": "preserve",
    "allowJs": true
  },
  "include": [
    "**/*.ts",
    "../e2e/**/*.ts",
    "../playwright.config.ts",
    "../vitest.config.ts",
    "../scripts/*.mjs",
    "../packages/rules/src/**/*.test.ts",
    "../packages/character/src/**/*.test.ts",
    "../packages/content/src/**/*.test.ts",
    "../packages/api/src/**/*.test.ts"
  ]
}
