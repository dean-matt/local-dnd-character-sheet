{
  "name": "local-dnd-character-sheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./packages/api\" --filter \"./packages/web\" run dev",
    "build": "pnpm -r run build",
    "content:sync": "pnpm --filter @dnd/content run sync",
    "content:build": "pnpm --filter @dnd/content run build:db",
    "db:studio": "pnpm --filter @dnd/api run db:studio",
    "db:generate": "pnpm --filter @dnd/api run db:generate",
    "db:migrate": "pnpm --filter @dnd/api run db:migrate",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "spell": "node scripts/spell.mjs",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm spell && pnpm deadcode && pnpm test",
    "prepare": "lefthook install",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
