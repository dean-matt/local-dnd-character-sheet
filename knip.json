{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts", "scripts/*.mjs"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/content": {},
    "packages/api": {
      "entry": ["src/db/homebrew.ts", "drizzle.homebrew.config.ts"]
    },
    "packages/web": {}
  },
  "ignoreBinaries": ["typos"]
}
