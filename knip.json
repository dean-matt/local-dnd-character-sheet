{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts", "scripts/*.mjs", "e2e/**/*.spec.ts"]
    },
    "packages/rules": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/character": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/dice": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/tags": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/content": {
      "entry": ["src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/api": {
      "entry": ["src/db/homebrew.ts", "drizzle.homebrew.config.ts"]
    },
    "packages/web": {}
  },
  "ignoreBinaries": ["typos"]
}
